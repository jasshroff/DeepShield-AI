# Get a Gemini API key from Google AI Studio, then paste it here.
GEMINI_API_KEY=your_key_here

# URL Context and Google Search examples in Google's current docs use Gemini models that support tools.
GEMINI_MODEL=gemini-3.5-flash

# Optional only for future real-time browser camera/mic streaming.
GEMINI_LIVE_MODEL=gemini-2.5-flash-live-preview
MAX_UPLOAD_MB=100
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional but recommended for stronger multi-source evidence checks.
# Google Custom Search JSON API / Programmable Search Engine.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Optional Google Fact Check Tools API key.
FACT_CHECK_API_KEY=

# Optional NewsAPI key. GDELT + RSS work without this.
NEWSAPI_KEY=

# Local evidence report folder.
EVIDENCE_DIR=evidence_reports

# Gemini's google_search / url_context tools are billed beyond a small free quota.
# Leave both False (default) to run fully free: local deepfake/AI-text classifiers +
# free DuckDuckGo/GDELT/RSS/FactCheck search instead. Set True only if Gemini billing is enabled.
ENABLE_GEMINI_SEARCH_GROUNDING=False
ENABLE_GEMINI_URL_CONTEXT=False
